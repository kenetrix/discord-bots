#!/usr/bin/env bash
# botctl – manage the bots on the bot machine
set -Eeuo pipefail

BOTS_DIR=/opt/bots
# Git checkouts live here, so /opt/bots/<name>/ only holds the bot's own files.
REPOS_DIR=/var/lib/botctl/repos
BOT_USER=bots

die() { echo "Error: $*" >&2; exit 1; }
as_bot() { su-exec "$BOT_USER" env HOME="/home/$BOT_USER" "$@"; }
need_root() { [[ $EUID -eq 0 ]] || die "Please run as root."; }
check_name() { [[ "${1:-}" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "Invalid bot name '${1:-}' (only a-z, 0-9, -)."; }
exists() { [[ -d "$BOTS_DIR/$1" && -f "/etc/init.d/bot.$1" ]] || die "Bot '$1' does not exist. 'botctl list' shows all bots."; }
app_dir() { sed -n 's/^directory="\(.*\)"$/\1/p' "/etc/init.d/bot.$1"; }
is_active() { rc-service "bot.$1" status >/dev/null 2>&1; }

check_sub() {
  [[ -z "$1" || ( "$1" =~ ^[A-Za-z0-9._/-]+$ && ! "$1" =~ (^|/)\.\.(/|$) ) ]] || die "Invalid subfolder '$1'."
}

ensure_repos_dir() {
  mkdir -p "$REPOS_DIR"
  chown "$BOT_USER:$BOT_USER" "$REPOS_DIR"
  chmod 0750 "$REPOS_DIR"
}

# clone_repo <name> <url> <branch> <subfolder>: shallow clone into the repo cache, only the subfolder checked out.
clone_repo() {
  local repo="$REPOS_DIR/$1" url="$2" branch="$3" sub="$4"
  ensure_repos_dir
  rm -rf "$repo"
  echo "Cloning ${url//\/\/*@/\/\/***@} …"
  as_bot git clone --quiet --depth 1 ${sub:+--sparse} ${branch:+--branch "$branch"} "$url" "$repo"
  [[ -z "$sub" ]] || as_bot git -C "$repo" sparse-checkout set -- "$sub"
  as_bot git -C "$repo" config botctl.path "$sub"
}

# Files of the subfolder tracked by git, relative to the subfolder.
tracked_files() {
  local repo="$REPOS_DIR/$1" sub; sub=$(as_bot git -C "$repo" config botctl.path || true)
  as_bot git -C "$repo" -c core.quotePath=false ls-files -- ${sub:+"$sub/"} | sed "s|^${sub:+$sub/}||"
}

# Copies the bot's files from the repo cache to /opt/bots/<name>/. Files that are not tracked
# by git (.env, data/, node_modules/ …) are never touched; files removed upstream are deleted.
deploy() {
  local name="$1" root="$BOTS_DIR/$1" repo="$REPOS_DIR/$1" sub src manifest rel dir
  sub=$(as_bot git -C "$repo" config botctl.path || true)
  src="$repo${sub:+/$sub}"
  [[ -f "$src/package.json" ]] || die "No package.json in ${sub:-the repository root}."
  manifest="$repo/.git/botctl-deployed"
  local new; new=$(tracked_files "$name")
  mkdir -p "$root"
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    mkdir -p "$root/$(dirname "$rel")"
    rm -f "$root/$rel"
    cp -pP "$src/$rel" "$root/$rel"
  done <<<"$new"
  if [[ -f "$manifest" ]]; then
    while IFS= read -r rel; do
      [[ -n "$rel" ]] && ! grep -qxF -- "$rel" <<<"$new" || continue
      rm -f "$root/$rel"
      dir=$(dirname "$rel")
      while [[ "$dir" != "." ]] && rmdir "$root/$dir" 2>/dev/null; do dir=$(dirname "$dir"); done
    done <"$manifest"
  fi
  printf '%s\n' "$new" >"$manifest"
  chown -R "$BOT_USER:$BOT_USER" "$root" "$manifest"
  chmod 0750 "$root"
}

# Bots installed before the repo cache had the whole repository in /opt/bots/<name>/ and the
# bot in a subfolder of it. Moves the git checkout out and keeps every untracked file of the bot.
migrate_legacy() {
  local name="$1" root="$BOTS_DIR/$1" dir sub url branch backup p rel
  dir=$(app_dir "$name")
  sub=""; [[ "$dir" == "$root" ]] || sub="${dir#"$root"/}"
  url=$(as_bot git -C "$root" remote get-url origin)
  branch=$(as_bot git -C "$root" rev-parse --abbrev-ref HEAD)
  echo "$name: moving the repository out of $root …"
  clone_repo "$name" "$url" "$branch" "$sub"
  rc-service "bot.$name" stop >/dev/null 2>&1 || true
  backup="$REPOS_DIR/$name.legacy"
  rm -rf "$backup"
  mv "$root" "$backup"
  mkdir -p "$root"
  # .env, data/ and anything else git does not track; node_modules/ is installed again.
  while IFS= read -r p; do
    p="${p%/}"; rel="${p#"${sub:+$sub/}"}"
    [[ -n "$rel" && "$rel" != node_modules && ! -e "$root/$rel" ]] || continue
    mkdir -p "$root/$(dirname "$rel")"
    mv "$backup/$p" "$root/$rel"
  done < <(as_bot git -C "$backup" -c core.quotePath=false ls-files --others --directory -- "${sub:-.}")
  sed -i "s|^directory=.*|directory=\"$root\"|" "/etc/init.d/bot.$name"
  deploy "$name"
  rm -rf "$backup"
}

install_deps() {
  local dir="$1"
  # npm would run "node-gyp rebuild" for better-sqlite3 (needs a compiler); its prebuilt binary is used instead.
  if [[ -f "$dir/package-lock.json" ]]; then
    (cd "$dir" && as_bot npm ci --omit=dev --ignore-scripts --no-audit --no-fund)
  else
    (cd "$dir" && as_bot npm install --omit=dev --ignore-scripts --no-audit --no-fund)
  fi
}

# Refreshes botctl and the web interface from the bot machine installer.
cmd_self_update() {
  need_root
  local url="${BOT_MACHINE_URL:-}"
  [[ -n "$url" ]] || url=$(cat /etc/botctl-web/source 2>/dev/null || true)
  [[ -n "$url" ]] || url="https://raw.githubusercontent.com/kenetrix/discord-bots/main/bot-machine"
  wget -qO- "$url/install.sh" | BOT_MACHINE_URL="$url" sh -s -- update
}

usage() {
  cat <<EOF
Usage: botctl <command> [arguments]

  add <name> <git-url> [--path <subfolder>] [--branch <branch>]
                     Install a bot from a git repo
  env <name>         Edit the bot's .env (token etc.)
  start <name>       Register slash commands (if available) and start
  stop <name>        Stop the bot
  restart <name>     Restart the bot
  update <name>      Pull the latest version, install dependencies, restart
                     (also moves bots of the old layout to the repo cache)
  update-all         Update every installed bot
  set <name> <KEY>   Set KEY in the bot's .env to the value read from stdin
  logs <name>        Show the live log (Ctrl+C to quit)
  status <name>      Show the service status
  self-update        Update botctl and the web interface themselves
  list               All bots with status
  remove <name>      Stop and delete the bot

Private repos: git URL with token, e.g.
  https://<token>@github.com/<user>/<repo>.git
EOF
}

cmd_add() {
  need_root
  local name="${1:-}" url="${2:-}" sub="" branch=""
  shift 2 || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --path) sub="${2:-}"; shift 2 ;;
      --branch) branch="${2:-}"; shift 2 ;;
      *) die "Unknown option: $1" ;;
    esac
  done
  check_name "$name"
  [[ -n "$url" ]] || die "Git URL is missing."
  [[ -e "$BOTS_DIR/$name" ]] && die "Bot '$name' already exists."

  check_sub "${sub#/}"
  sub="${sub#/}"; sub="${sub%/}"

  local dir="$BOTS_DIR/$name"
  # A failed add must not leave a half-installed bot behind.
  ADD_OK=0 ADD_NAME="$name"
  trap 'if [[ $ADD_OK -ne 1 ]]; then rm -rf "$BOTS_DIR/$ADD_NAME" "$REPOS_DIR/$ADD_NAME" "/etc/init.d/bot.$ADD_NAME"; fi' EXIT
  clone_repo "$name" "$url" "$branch" "$sub"
  deploy "$name"

  echo "Installing dependencies …"
  install_deps "$dir"

  if [[ ! -f "$dir/.env" ]]; then
    if [[ -f "$dir/.env.example" ]]; then cp "$dir/.env.example" "$dir/.env"; else touch "$dir/.env"; fi
    chown "$BOT_USER:$BOT_USER" "$dir/.env"
    chmod 0600 "$dir/.env"
  fi

  # The bot reads its own .env (dotenv), so the service only needs the working directory.
  cat > "/etc/init.d/bot.$name" <<EOF
#!/sbin/openrc-run
description="Bot $name"
directory="$dir"
command="/usr/bin/npm"
command_args="start --silent"
command_user="$BOT_USER:$BOT_USER"
command_background="yes"
pidfile="/run/bot.$name.pid"
output_log="/var/log/bots/$name.log"
error_log="/var/log/bots/$name.log"
export NODE_ENV=production

depend() {
  need net
}
EOF
  chmod 0755 "/etc/init.d/bot.$name"
  rc-update add "bot.$name" default >/dev/null
  ADD_OK=1

  echo
  echo "Bot '$name' installed in $dir"
  echo "Next steps:"
  echo "  botctl env $name     # enter token and IDs"
  echo "  botctl start $name"
}

cmd_env() {
  exists "$1"
  local dir; dir=$(app_dir "$1")
  "${EDITOR:-nano}" "$dir/.env"
  if is_active "$1"; then
    read -rp "Restart the bot now? [Y/n] " a
    [[ "${a,,}" == "n" ]] || rc-service "bot.$1" restart
  fi
}

register_commands() {
  local dir; dir=$(app_dir "$1")
  (cd "$dir" && as_bot npm run --silent --if-present deploy-commands) || echo "Warning: deploy-commands failed."
}

cmd_start() { exists "$1"; register_commands "$1"; rc-service "bot.$1" start; echo "Started. Log: botctl logs $1"; }

cmd_update() {
  need_root; exists "$1"
  local root="$BOTS_DIR/$1" repo="$REPOS_DIR/$1" before after branch
  local was_active=0; is_active "$1" && was_active=1
  if [[ -d "$root/.git" ]]; then
    before=$(as_bot git -C "$root" rev-parse --short HEAD)
    migrate_legacy "$1"
  else
    [[ -d "$repo/.git" ]] || die "No repository for '$1' in $REPOS_DIR. Remove the bot and add it again."
    before=$(as_bot git -C "$repo" rev-parse --short HEAD)
    branch=$(as_bot git -C "$repo" rev-parse --abbrev-ref HEAD)
    as_bot git -C "$repo" fetch --quiet --depth 1 origin "$branch"
    as_bot git -C "$repo" reset --quiet --hard FETCH_HEAD
    deploy "$1"
  fi
  after=$(as_bot git -C "$repo" rev-parse --short HEAD)
  echo "$1: $before → $after"
  local dir; dir=$(app_dir "$1")
  install_deps "$dir"
  register_commands "$1"
  if [[ $was_active -eq 1 ]]; then
    rc-service "bot.$1" restart
    echo "Restarted."
  else
    echo "Not running, so not restarted. Start it with: botctl start $1"
  fi
}

cmd_update_all() {
  need_root
  local root name rc=0
  shopt -s nullglob
  for root in "$BOTS_DIR"/*/; do
    name=$(basename "$root")
    if [[ ! -f "/etc/init.d/bot.$name" ]]; then
      echo "$name: incomplete installation, skipping. Remove it with 'rm -rf $root' and run 'botctl add' again." >&2
      rc=1
      continue
    fi
    cmd_update "$name" || { echo "Update of $name failed." >&2; rc=1; }
  done
  return "$rc"
}

cmd_set() {
  need_root; exists "$1"
  local key="${2:-}" value line file tmp found=0
  [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || die "Invalid key '$key'."
  IFS= read -r value
  file="$(app_dir "$1")/.env"
  [[ -f "$file" ]] || die "No .env found for '$1'."
  tmp=$(mktemp)
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$key="* ]]; then
      printf '%s=%s\n' "$key" "$value"; found=1
    else
      printf '%s\n' "$line"
    fi
  done <"$file" >"$tmp"
  [[ $found -eq 1 ]] || printf '%s=%s\n' "$key" "$value" >>"$tmp"
  cat "$tmp" >"$file"
  rm -f "$tmp"
}

cmd_list() {
  printf '%-20s %-10s %-9s %s\n' NAME STATUS VERSION DIRECTORY
  shopt -s nullglob
  for root in "$BOTS_DIR"/*/; do
    local name; name=$(basename "$root")
    local state=stopped; is_active "$name" && state=started
    local rev; rev=$(as_bot git -C "$REPOS_DIR/$name" rev-parse --short HEAD 2>/dev/null ||
      as_bot git -C "$root" rev-parse --short HEAD 2>/dev/null || echo "-")
    printf '%-20s %-10s %-9s %s\n' "$name" "$state" "$rev" "$(app_dir "$name")"
  done
}

cmd_remove() {
  need_root; exists "$1"
  read -rp "Really delete bot '$1' including its data? Type the name to confirm: " a
  [[ "$a" == "$1" ]] || die "Aborted."
  rc-service "bot.$1" stop >/dev/null 2>&1 || true
  rc-update del "bot.$1" default >/dev/null 2>&1 || true
  rm -rf "/etc/init.d/bot.$1" "/var/log/bots/$1.log" "${BOTS_DIR:?}/$1" "${REPOS_DIR:?}/$1"
  echo "Bot '$1' deleted."
}

cmd="${1:-}"; shift || true
case "$cmd" in
  add) cmd_add "$@" ;;
  env) check_name "${1:-}"; cmd_env "$1" ;;
  start) check_name "${1:-}"; cmd_start "$1" ;;
  stop|restart|status) check_name "${1:-}"; exists "$1"; rc-service "bot.$1" "$cmd" ;;
  update) check_name "${1:-}"; cmd_update "$1" ;;
  update-all) cmd_update_all ;;
  self-update) cmd_self_update ;;
  set) check_name "${1:-}"; cmd_set "$1" "${2:-}" ;;
  logs) check_name "${1:-}"; exists "$1"; tail -n 100 -f "/var/log/bots/$1.log" ;;
  list|ls) cmd_list ;;
  remove|rm) check_name "${1:-}"; cmd_remove "$1" ;;
  ""|-h|--help|help) usage ;;
  *) usage; exit 1 ;;
esac

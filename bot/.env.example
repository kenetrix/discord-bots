# Bot token from the Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (General Information > Application ID)
CLIENT_ID=
# Optional: server ID so slash commands show up instantly, on that server only
GUILD_ID=
# Optional: path to the SQLite file (default: ./data/bot.db)
# DB_PATH=/opt/bots/ken-bot/data/bot.db
# Time zone for cleaner schedules
TZ=Europe/Berlin

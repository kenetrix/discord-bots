# Bot-Token aus dem Discord Developer Portal (Bot > Reset Token)
DISCORD_TOKEN=
# Application ID (General Information > Application ID)
CLIENT_ID=
# Optional: Server-ID, damit Slash-Commands sofort nur dort erscheinen
GUILD_ID=
# Optional: Pfad zur SQLite-Datei (Standard: ./data/bot.db)
# DB_PATH=/opt/bots/ken-bot/data/bot.db
# Zeitzone für Cleaner-Zeitpläne
TZ=Europe/Berlin
